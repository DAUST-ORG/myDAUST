# myDAUST environment template — committed. Copy to .env and fill real values.
# .env is gitignored. NEVER put real secrets in this file.

# --- AWS (pointers only — creds come from the SSO profile, NOT from here) ---
AWS_PROFILE=961828155948_DAUST_ADMIN
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=961828155948
WIRE_PROOFS_BUCKET=
MEDIA_BUCKET=
TRANSCRIPT_IMPORT_BUCKET=

# --- Cloudflare (DNS-as-code) ---
# Scoped token: DNS edit + Origin CA on the azertica.com zone. SECRET — local .env only.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE=azertica.com

# --- Database ---
DATABASE_URL=postgresql://mydaust:mydaust@localhost:5432/mydaust?schema=public

# --- Observability (DSN/keys are publishable but env-managed; auth token is SECRET) ---
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# --- App runtime (added with the P2-P5 build) ---
PORT=4000
PORTAL_ORIGIN=http://localhost:3000
VITRINE_ORIGIN=http://localhost:3001
# Production API URL — vitrine resolves /uploads images via this host.
# Must be set to the real API endpoint (e.g. https://api.daust.net) when deployed.
NEXT_PUBLIC_API_URL=https://api.daust.net
# Any random 32+ char string; boot fails in production if left at the dev default.
SESSION_SECRET=

# --- Transactional email (optional; api dev-logs emails to console when unset) ---
RESEND_API_KEY=
MAIL_FROM=myDAUST <no-reply@daust.org>

# --- PI-SPI (BCEAO instant payment / request-to-pay) ---
# Leave PI_SPI_ENABLED=false until every value below is set: the rail needs an OAuth2
# client, an API key AND a mutual-TLS client certificate (provisioned via the PICERT
# portal). Without the certificate the gateway drops the TLS connection outright.
PI_SPI_ENABLED=false
PI_SPI_BASE_URL=https://sandbox.api.pi-bceao.com/piz/v1
PI_SPI_TOKEN_URL=
PI_SPI_CLIENT_ID=
PI_SPI_CLIENT_SECRET=
PI_SPI_API_KEY=
# DAUST's own alias (UUID) — the account every request-to-pay credits.
PI_SPI_PAYE_ALIAS=
# Shared secret PI-SPI signs webhook bodies with (POST /webhooks/{id}/secrets).
PI_SPI_WEBHOOK_SECRET=
# PEM client certificate + private key. Keep the key in Secrets Manager, never in git.
PI_SPI_CLIENT_CERT=
PI_SPI_CLIENT_KEY=
PI_SPI_REQUEST_TTL_HOURS=72
