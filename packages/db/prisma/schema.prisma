// myDAUST data model — Phase 1 (payments domain).
// All money is integer XOF (zero-decimal CFA). Per-transaction amounts (millions FCFA)
// fit comfortably in Int; billion-scale aggregates are computed, never stored as Int.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PersonStatus {
  active
  // Cannot sign in; live sessions ended via Person.sessionVersion.
  suspended
}

enum PersonKind {
  student
  faculty
  staff
  // Guardian of one or more students. Holds the `parent` role; never a Student row.
  parent
}

enum PaymentMethod {
  wave
  orange_money
  card
  wire
  // Cash received and recorded directly by a named Finance staff member.
  // Accounting-only: payer-facing checkout endpoints must never offer it.
  cash
  // Historical/manual bank records may be settled by cheque. This remains an
  // accounting value only; payer-facing checkout endpoints do not offer it.
  cheque
  // BCEAO instant-payment rail. Unlike proof-based methods it is
  // request-to-pay: the payer approves in their own banking app, so settlement is
  // asynchronous rather than a redirect return.
  pi_spi
  // Accounting-only value for reviewed legacy cash whose original rail is not
  // recoverable. Payer-facing checkout endpoints must never offer this method.
  legacy_unknown
}

/**
 * Lifecycle of a PI-SPI request-to-pay ("demande de paiement").
 */
enum PiSpiRequestStatus {
  initiated
  sent
  settled
  cancelled
  rejected
  expired
}

enum PaymentStatus {
  pending
  success
  refund_pending
  failed
  cancelled
  refunded
}

enum PaymentImportBatchStatus {
  pending
  imported
  failed
}

/// Final disposition of one paid-to-date workbook row. A later reviewed pass
/// may resolve a held row, but a physical source row can post cash only once.
enum PaymentBalanceImportDisposition {
  post_delta
  already_reconciled
  previously_imported
  held
}

enum PaymentSubmissionStatus {
  awaiting_proof
  submitted
  approved
  rejected
  cancelled

  @@map("WireTransferStatus")
}

enum PaymentAuditStatus {
  unreviewed
  reviewed
  flagged
}

enum InstallmentStatus {
  pending
  partial
  paid
  overdue
}

enum InvoiceStatus {
  open
  partial
  paid
  void
}

enum InvoicePackageType {
  standard_full
  standard_tuition_legacy
  custom
  credit
}

enum FeeScheduleStatus {
  draft
  approved
  superseded
}

enum ApprovalRequestStatus {
  pending
  approved
  rejected
  cancelled
  stale
}

enum ApprovalRequestKind {
  academic_catalog
  global_fee_schedule
  custom_charge
  charge_removal
  payment_plan
  discount
  scholarship
  operating_budget
  management_actual
  student_enrollment_override
}

enum OperatingBudgetStatus {
  draft
  pending
  approved
  rejected
  superseded
}

enum ManagementCategoryKind {
  income
  expense
}

enum ManagementRecordStatus {
  pending
  approved
  rejected
  void
  corrected
}

enum ManagementActualEntryType {
  manual_income
  adjustment
}

enum EnrollmentStatus {
  enrolled
  dropped
  completed
}

enum StudentRecordStatus {
  pending_payment
  active
  archived
}

enum ApplicantOnboardingStatus {
  not_started
  payment_pending
  enrolled
  cancelled
}

enum AttendanceStatus {
  present
  late
  absent
}

enum AssignmentType {
  homework
  quiz
  exam
  project
}

enum SubmissionStatus {
  assigned
  submitted
  graded
}

enum CostCenterType {
  group
  operating
  auxiliary
  revenue
  reserve
  capital
  restricted
}

model CostCenter {
  code                    String                  @id
  name                    String
  type                    CostCenterType
  parentCode              String?
  parent                  CostCenter?             @relation("CostCenterTree", fields: [parentCode], references: [code])
  children                CostCenter[]            @relation("CostCenterTree")
  invoices                Invoice[]
  invoiceComponents       InvoiceComponent[]
  feeScheduleComponents   FeeScheduleComponent[]
  expenses                Expense[]
  budgets                 Budget[]
  managementActualEntries ManagementActualEntry[]

  @@index([parentCode])
}

// Management-accounting expense (manual/estimated). Financial accounting (GL) deferred to ERP.
model Expense {
  id                    String                 @id @default(uuid())
  costCenterCode        String
  costCenter            CostCenter             @relation(fields: [costCenterCode], references: [code])
  category              String // Legacy display label. New records also link managementCategoryKey.
  managementCategoryKey String?
  managementCategory    ManagementCategory?    @relation(fields: [managementCategoryKey], references: [key], onDelete: SetNull)
  academicYearId        String?
  academicYear          AcademicYear?          @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  description           String?
  payee                 String? // human-readable label only (vendor or employee display name)
  // Canonical employee link for salary rows — payslips join on this, never on the mutable payee name.
  personId              String?
  amount                Int // integer XOF
  isEstimate            Boolean                @default(false)
  incurredOn            DateTime
  status                ManagementRecordStatus @default(approved)
  revision              Int                    @default(0)
  correctionOfId        String?
  correctionOf          Expense?               @relation("ExpenseCorrection", fields: [correctionOfId], references: [id], onDelete: Restrict)
  corrections           Expense[]              @relation("ExpenseCorrection")
  approvalRequestId     String?                @unique
  approvalRequest       ApprovalRequest?       @relation("ExpenseApproval", fields: [approvalRequestId], references: [id], onDelete: SetNull)
  voidApprovalRequestId String?                @unique
  voidApprovalRequest   ApprovalRequest?       @relation("ExpenseVoidApproval", fields: [voidApprovalRequestId], references: [id], onDelete: SetNull)
  createdById           String?
  approvedById          String?
  approvedBy            Person?                @relation("ExpenseApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt            DateTime?
  voidedById            String?
  voidedBy              Person?                @relation("ExpenseVoider", fields: [voidedById], references: [id], onDelete: SetNull)
  voidedAt              DateTime?
  voidReason            String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([costCenterCode])
  @@index([incurredOn])
  @@index([personId])
  @@index([academicYearId, status, incurredOn])
  @@index([managementCategoryKey, status, incurredOn])
  @@index([correctionOfId])
  @@index([approvedById])
  @@index([voidedById])
}

model Budget {
  id             String     @id @default(uuid())
  costCenterCode String
  costCenter     CostCenter @relation(fields: [costCenterCode], references: [code])
  fiscalYear     String // e.g. "FY2026"
  allocated      Int // integer XOF

  @@unique([costCenterCode, fiscalYear])
}

/// Stable management-reporting categories shared by plans, approved expenses,
/// non-Bursar income and signed actual corrections.
model ManagementCategory {
  key           String                  @id
  label         String
  kind          ManagementCategoryKind
  sortOrder     Int
  isActive      Boolean                 @default(true)
  budgetLines   OperatingBudgetLine[]
  expenses      Expense[]
  actualEntries ManagementActualEntry[]

  @@unique([kind, label])
  @@index([kind, sortOrder])
}

/// One version of the institution's August-July operating plan. Approved
/// revisions are immutable snapshots; later versions supersede rather than edit.
model OperatingBudget {
  id                String                @id @default(uuid())
  academicYearId    String
  academicYear      AcademicYear          @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  revision          Int
  contentVersion    Int                   @default(0)
  status            OperatingBudgetStatus @default(draft)
  openingBalanceXof BigInt                @default(0)
  reason            String?
  baseRevision      Int                   @default(0)
  approvalRequestId String?               @unique
  approvalRequest   ApprovalRequest?      @relation("OperatingBudgetApproval", fields: [approvalRequestId], references: [id], onDelete: SetNull)
  createdById       String
  createdBy         Person                @relation("OperatingBudgetCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedById      String?
  reviewedBy        Person?               @relation("OperatingBudgetReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  submittedAt       DateTime?
  reviewedAt        DateTime?
  approvedAt        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  lines             OperatingBudgetLine[]

  @@unique([academicYearId, revision])
  @@index([academicYearId, status, createdAt])
  @@index([createdById, createdAt])
  @@index([reviewedById])
}

/// A planned category amount for one academic-year month. monthIndex is ordered
/// from August (0) through July (11), independent of locale/time-zone parsing.
model OperatingBudgetLine {
  id          String             @id @default(uuid())
  budgetId    String
  budget      OperatingBudget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  categoryKey String
  category    ManagementCategory @relation(fields: [categoryKey], references: [key], onDelete: Restrict)
  monthIndex  Int
  amountXof   BigInt

  @@unique([budgetId, categoryKey, monthIndex])
  @@index([categoryKey])
}

/// Approved non-Bursar income and signed management-reporting adjustments.
/// Source payments and expenses remain immutable; aggregate cell edits append
/// an adjustment whose signed amount reconciles baseActualXof to targetActualXof.
model ManagementActualEntry {
  id                    String                    @id @default(uuid())
  academicYearId        String
  academicYear          AcademicYear              @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  categoryKey           String
  category              ManagementCategory        @relation(fields: [categoryKey], references: [key], onDelete: Restrict)
  costCenterCode        String
  costCenter            CostCenter                @relation(fields: [costCenterCode], references: [code], onDelete: Restrict)
  type                  ManagementActualEntryType
  status                ManagementRecordStatus    @default(pending)
  amountXof             BigInt
  baseActualXof         BigInt?
  targetActualXof       BigInt?
  occurredOn            DateTime                  @db.Date
  description           String
  revision              Int                       @default(0)
  correctionOfId        String?
  correctionOf          ManagementActualEntry?    @relation("ManagementActualCorrection", fields: [correctionOfId], references: [id], onDelete: Restrict)
  corrections           ManagementActualEntry[]   @relation("ManagementActualCorrection")
  approvalRequestId     String?                   @unique
  approvalRequest       ApprovalRequest?          @relation("ManagementActualApproval", fields: [approvalRequestId], references: [id], onDelete: SetNull)
  voidApprovalRequestId String?                   @unique
  voidApprovalRequest   ApprovalRequest?          @relation("ManagementActualVoidApproval", fields: [voidApprovalRequestId], references: [id], onDelete: SetNull)
  createdById           String
  createdBy             Person                    @relation("ManagementActualCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedById          String?
  approvedBy            Person?                   @relation("ManagementActualApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt            DateTime?
  voidedById            String?
  voidedBy              Person?                   @relation("ManagementActualVoider", fields: [voidedById], references: [id], onDelete: SetNull)
  voidedAt              DateTime?
  voidReason            String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@index([academicYearId, status, occurredOn])
  @@index([categoryKey, status, occurredOn])
  @@index([costCenterCode, status, occurredOn])
  @@index([correctionOfId])
  @@index([createdById, createdAt])
  @@index([approvedById])
  @@index([voidedById])
}

model Person {
  id                            String                       @id @default(uuid())
  email                         String?                      @unique
  firstName                     String
  lastName                      String
  kind                          PersonKind
  // App RBAC roles (a person can hold several). Validated against AppRole in code.
  roles                         String[]                     @default([])
  // bcrypt hash; null until a password is set.
  passwordHash                  String?
  // Set when a temp password was assigned; forces a change on next login.
  mustChangePassword            Boolean                      @default(false)
  // Suspended accounts cannot sign in and their live sessions are ended (see sessionVersion).
  // DB CHECK Person_suspended_has_timestamp keeps status and suspendedAt in agreement.
  status                        PersonStatus                 @default(active)
  suspendedAt                   DateTime?
  suspendedById                 String?
  // Signed into the session JWT at login and compared on every authenticated request.
  // Bump it to end every live session this person holds.
  sessionVersion                Int                          @default(0)
  createdAt                     DateTime                     @default(now())
  student                       Student?
  taughtSections                Section[]                    @relation("Instructor")
  threadParticipations          ThreadParticipant[]
  messagesSent                  Message[]
  projectMemberships            ProjectMember[]
  // --- SIS redesign ---
  guardianOf                    GuardianStudent[]            @relation("GuardianOf")
  guardianProfile               GuardianProfile?
  guardianInvites               GuardianInvite[]             @relation("GuardianInvites")
  studentInvites                StudentInvite[]              @relation("StudentInvites")
  activationRequestsAsStudent   StudentActivationRequest[]   @relation("StudentActivationRequestStudent")
  activationRequestsApproved    StudentActivationRequest[]   @relation("StudentActivationRequestApprover")
  studentActivationCards        StudentActivationCard[]      @relation("StudentActivationCardStudent")
  activationCardBatchesCreated  StudentActivationCardBatch[] @relation("StudentActivationCardBatchCreator")
  activationCardBatchesRevoked  StudentActivationCardBatch[] @relation("StudentActivationCardBatchRevoker")
  broadcasts                    Broadcast[]                  @relation("BroadcastSender")
  // Public website profile for faculty (see FacultyProfile).
  facultyProfile                FacultyProfile?
  paymentSubmissionsStarted     PaymentSubmission[]          @relation("PaymentSubmissionInitiator")
  paymentSubmissionsVerified    PaymentSubmission[]          @relation("PaymentSubmissionVerifier")
  paymentSubmissionsAudited     PaymentSubmission[]          @relation("PaymentSubmissionAuditor")
  transcriptImportBatches       TranscriptImportBatch[]      @relation("TranscriptImportBatchCreator")
  paymentImportBatches          PaymentImportBatch[]         @relation("PaymentImportBatchCreator")
  paymentBalanceImportBatches   PaymentBalanceImportBatch[]  @relation("PaymentBalanceImportBatchCreator")
  legacyCohortImportBatches     LegacyCohortImportBatch[]    @relation("LegacyCohortImportBatchCreator")
  transcriptEntriesCreated      TranscriptEntry[]            @relation("TranscriptEntryCreator")
  transcriptEntriesUpdated      TranscriptEntry[]            @relation("TranscriptEntryUpdater")
  transcriptEntriesVoided       TranscriptEntry[]            @relation("TranscriptEntryVoider")
  paymentsInitiated             Payment[]                    @relation("PaymentInitiator")
  feeSchedulesCreated           FeeSchedule[]                @relation("FeeScheduleCreator")
  feeSchedulesApproved          FeeSchedule[]                @relation("FeeScheduleApprover")
  academicCatalogsCreated       AcademicCatalogRevision[]    @relation("AcademicCatalogCreator")
  academicCatalogsApproved      AcademicCatalogRevision[]    @relation("AcademicCatalogApprover")
  infirmaryConsultations        Consultation[]               @relation("ConsultationClinician")
  infirmaryConsultationsFlagged Consultation[]               @relation("ConsultationSickFlagger")
  attendanceNotedBy             AttendanceRecord[]           @relation("AttendanceNotedBy")
  infirmaryPrescriptions        Prescription[]               @relation("PrescriptionAuthor")
  infirmaryDocuments            InfirmaryDocument[]          @relation("DocumentUploader")
  standingOverridesCreated      StudentStandingOverride[]    @relation("StandingOverrideCreator")
  standingOverridesUpdated      StudentStandingOverride[]    @relation("StandingOverrideUpdater")
  standingOverridesCleared      StudentStandingOverride[]    @relation("StandingOverrideClearer")
  approvalRequestsCreated       ApprovalRequest[]            @relation("ApprovalRequester")
  approvalRequestsReviewed      ApprovalRequest[]            @relation("ApprovalReviewer")
  approvalEvents                ApprovalEvent[]              @relation("ApprovalEventActor")
  operatingBudgetsCreated       OperatingBudget[]            @relation("OperatingBudgetCreator")
  operatingBudgetsReviewed      OperatingBudget[]            @relation("OperatingBudgetReviewer")
  managementActualsCreated      ManagementActualEntry[]      @relation("ManagementActualCreator")
  managementActualsApproved     ManagementActualEntry[]      @relation("ManagementActualApprover")
  managementActualsVoided       ManagementActualEntry[]      @relation("ManagementActualVoider")
  expensesApproved              Expense[]                    @relation("ExpenseApprover")
  expensesVoided                Expense[]                    @relation("ExpenseVoider")
  directorWidgetPreference      DirectorWidgetPreference?
  notifications                 Notification[]
  admissionNotes                AdmissionNote[]              @relation("AdmissionNoteAuthor")
  createdForms                  CustomForm[]

  @@index([status])
}

model Student {
  id                       String                    @id @default(uuid())
  personId                 String                    @unique
  person                   Person                    @relation(fields: [personId], references: [id])
  studentNo                String                    @unique
  programId                String?
  program                  Program?                  @relation(fields: [programId], references: [id])
  // Date of birth (date only). Second factor for the public bill-payment lookup.
  dateOfBirth              DateTime?
  // Roster photo, resolved to an absolute URL (served from the vitrine bucket).
  photoUrl                 String?
  // --- Extended SIS profile (all optional; captured via the admin Edit-record form) ---
  gender                   String?
  phone                    String?
  address                  String?
  city                     String?
  nationality              String?
  guardianName             String?
  guardianRelation         String?
  guardianPhone            String?
  advisor                  String? // free-text advisor name (no faculty FK yet)
  yearLevel                Int? // year of study 1..N
  cohort                   String? // e.g. "Class of 2028"
  enrolledAt               DateTime? // first enrolment date
  // --- Remaining SIS profile fields (SIS redesign; all optional) ---
  preferredName            String?
  nationalId               String?
  maritalStatus            String?
  personalEmail            String? // non-institutional address
  // Saved PI-SPI payment alias, so a returning payer does not retype it. Always
  // overridable at pay time; never used without the payer confirming the resolved name.
  piSpiAlias               String?
  language                 String? // preferred language, e.g. "French"
  bloodType                String?
  allergies                String?
  insurance                String? // provider + policy number
  physician                String? // campus physician
  emergencyName2           String?
  emergencyPhone2          String?
  major                    String?
  minor                    String?
  admitTerm                String?
  expectedGrad             String?
  enrollmentStatus         String? // full-time | part-time | leave
  catalogYear              String? // requirement set the student is audited against
  catalogYearId            String?
  catalogAcademicYear      AcademicYear?             @relation("StudentCatalogYear", fields: [catalogYearId], references: [id], onDelete: SetNull)
  standing                 String? // Good Standing | Probation | ...
  // Lifecycle of the SIS record itself. Archiving hides a student from active
  // rosters without deleting their academic or financial history.
  recordStatus             StudentRecordStatus       @default(active)
  applicant                Applicant?                @relation("ApplicantStudent")
  legacyCohortImport       LegacyCohortImportPerson?
  holds                    StudentHold[]
  alerts                   StudentAlert[]
  watchers                 StaffWatch[]
  guardians                GuardianStudent[]
  invoices                 Invoice[]
  payments                 Payment[]
  paymentBalanceImportRows PaymentBalanceImportRow[]
  paymentSubmissions       PaymentSubmission[]
  piSpiRequests            PiSpiRequest[]
  enrollments              Enrollment[]
  transcriptEntries        TranscriptEntry[]
  standingOverrides        StudentStandingOverride[]
  gradeSubmissionItems     GradeSubmissionItem[]
  mealPlan                 MealPlan?
  diningOrders             DiningOrder[]
  diningScans              DiningScan[]
  housing                  HousingAssignment?
  roommateProfile          RoommateProfile?
  documents                StudentDocument[]
  infirmaryConsultations   Consultation[]
  infirmaryPrescriptions   Prescription[]
  infirmaryAppointments    InfirmaryAppointment[]
  infirmaryDocuments       InfirmaryDocument[]
  infirmaryFollowUps       FollowUp[]
  infirmaryFormResponses   InfirmaryFormResponse[]
  createdAt                DateTime                  @default(now())

  @@index([recordStatus])
  @@index([catalogYearId])
}

/// A faculty member's public-website profile. Only people whose roles include
/// "faculty" get one; `publicProfile` gates whether they appear on the site.
model FacultyProfile {
  id            String   @id @default(uuid())
  personId      String   @unique
  person        Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  // Professional profile (displayed on the public Faculty page).
  title         String? // e.g. "Associate Professor of Mechanical Engineering"
  dept          String? // department / research center
  bio           String? // short paragraph
  interests     String[] @default([]) // research interests
  scholar       String? // publications / research profile link
  photoUrl      String? // roster photo, resolved to an absolute URL (/uploads/...)
  // Site visibility — toggled from the comms Faculty manager.
  publicProfile Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([publicProfile])
}

model Term {
  id                   String                   @id @default(uuid())
  name                 String                   @unique
  startDate            DateTime
  endDate              DateTime
  // Registration windows. Null = falls back to endDate (add) / unbounded (drop).
  addDeadline          DateTime?
  dropDeadline         DateTime?
  // Which catalog year this term belongs to (e.g. Fall 2026 -> 2026-2027).
  academicYearId       String?
  academicYear         AcademicYear?            @relation(fields: [academicYearId], references: [id])
  // Fall | Spring | Summer — the semester slot a curriculum entry maps onto.
  semester             String?
  // active | planning | draft — the registrar's term lifecycle. Only one active.
  status               String?
  invoices             Invoice[]
  sections             Section[]
  transcriptEntries    TranscriptEntry[]
  gradeSubmissionItems GradeSubmissionItem[]
  evaluationWindows    CourseEvaluationWindow[]
}

model Invoice {
  id                       String                     @id @default(uuid())
  // Human-readable billing handle shown to staff, e.g. "BILL-2026-001".
  number                   String?                    @unique
  studentId                String
  student                  Student                    @relation(fields: [studentId], references: [id])
  termId                   String
  term                     Term                       @relation(fields: [termId], references: [id])
  totalAmount              Int
  amountPaid               Int                        @default(0)
  status                   InvoiceStatus              @default(open)
  // Human label for an ad-hoc charge (e.g. "Lab & technology fee"); null for tuition.
  description              String?
  // Revenue dimension for the director dashboard (tuition -> 9100).
  costCenterCode           String                     @default("9100")
  costCenter               CostCenter                 @relation(fields: [costCenterCode], references: [code])
  packageType              InvoicePackageType         @default(custom)
  academicYearLabel        String?
  feeScheduleId            String?
  feeScheduleRevision      Int?
  feeSchedule              FeeSchedule?               @relation(fields: [feeScheduleId], references: [id], onDelete: SetNull)
  /// True only when this invoice has custom installment dates/count. Component
  /// selections use InvoiceComponentOverride and keep inheriting the schedule.
  paymentPlanOverride      Boolean                    @default(false)
  revision                 Int                        @default(0)
  components               InvoiceComponent[]
  componentOverrides       InvoiceComponentOverride[]
  plan                     PaymentPlan?
  payments                 Payment[]
  paymentSubmissions       PaymentSubmission[]
  piSpiRequests            PiSpiRequest[]
  enrollmentForApplicant   Applicant?                 @relation("ApplicantEnrollmentInvoice")
  legacyCohortImport       LegacyCohortImportPerson?
  paymentBalanceImportRows PaymentBalanceImportRow[]
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt

  @@index([studentId])
  @@index([termId])
  @@index([status])
  @@index([feeScheduleId])
  @@index([packageType, academicYearLabel])
}

model PaymentPlan {
  id           String        @id @default(uuid())
  invoiceId    String        @unique
  invoice      Invoice       @relation(fields: [invoiceId], references: [id])
  createdById  String?
  installments Installment[]
  createdAt    DateTime      @default(now())
}

model Installment {
  id          String                 @id @default(uuid())
  planId      String
  plan        PaymentPlan            @relation(fields: [planId], references: [id])
  sequence    Int
  // Staff-facing name for this installment, e.g. "Inscription"; null falls back to the sequence.
  label       String?
  /// Inclusive payment-plan calendar date in Africa/Dakar (not a timestamp).
  dueDate     DateTime               @db.Date
  amountDue   Int
  amountPaid  Int                    @default(0)
  status      InstallmentStatus      @default(pending)
  allocations PaymentAllocation[]
  /// Optional per-student split of this due amount across the invoice's charge
  /// components. Absence means the installment inherits the standard aggregate
  /// schedule; presence freezes Finance's individual component schedule.
  components  InstallmentComponent[]

  @@unique([planId, sequence])
  @@index([dueDate])
  @@index([status])
}

model Payment {
  id                                 String                       @id @default(uuid())
  invoiceId                          String
  invoice                            Invoice                      @relation(fields: [invoiceId], references: [id])
  studentId                          String
  student                            Student                      @relation(fields: [studentId], references: [id])
  amount                             Int
  method                             PaymentMethod
  status                             PaymentStatus                @default(pending)
  provider                           String                       @default("manual")
  // Idempotency anchor: the gateway transaction reference is unique.
  providerRef                        String                       @unique
  /// SHA-256 of payment method + canonical external accounting reference.
  /// Nullable for ordinary gateway payments; reviewed historical imports set it.
  externalReferenceFingerprintSha256 String?                      @unique
  /// Durable origin of the payment attempt (student_portal, parent_portal, public_bill, ...).
  source                             String                       @default("legacy")
  initiatedById                      String?
  initiatedBy                        Person?                      @relation("PaymentInitiator", fields: [initiatedById], references: [id], onDelete: SetNull)
  initiatedByEmail                   String?
  settledAt                          DateTime?
  refundedAt                         DateTime?
  /// Present only for reviewed historical-workbook imports. The source row is
  /// immutable provenance; it never replaces the canonical payment ledger.
  importBatchId                      String?
  importBatch                        PaymentImportBatch?          @relation(fields: [importBatchId], references: [id], onDelete: Restrict)
  importRowKey                       String?
  importSheetName                    String?
  importRowNumber                    Int?
  ipnPayload                         Json?
  allocations                        PaymentAllocation[]
  componentAllocations               PaymentComponentAllocation[]
  submission                         PaymentSubmission?
  piSpiRequest                       PiSpiRequest?
  activatedApplicant                 Applicant?                   @relation("ApplicantActivationPayment")
  legacyCohortRows                   LegacyCohortImportRow[]
  paymentBalanceImportRow            PaymentBalanceImportRow?
  createdAt                          DateTime                     @default(now())
  updatedAt                          DateTime                     @updatedAt

  @@unique([importBatchId, importRowKey])
  @@index([invoiceId])
  @@index([status])
  @@index([settledAt])
  @@index([initiatedById])
  @@index([importBatchId])
}

/// One reviewed, idempotent historical-payment workbook load. The source hash
/// prevents exact-workbook reruns; row keys and Payment.providerRef protect
/// individual rows and concurrent retries.
model PaymentImportBatch {
  id                      String                   @id @default(uuid())
  sourceFileName          String
  sourceSha256            String                   @unique
  sourceExtractionSha256  String
  manifestSha256          String
  status                  PaymentImportBatchStatus @default(pending)
  academicYear            String
  sourceGroupCount        Int                      @default(0)
  totalRows               Int                      @default(0)
  importedRows            Int                      @default(0)
  alreadyRecordedRows     Int                      @default(0)
  excludedSourceGroups    Int                      @default(0)
  skippedRows             Int                      @default(0)
  errorRows               Int                      @default(0)
  sourceTotalXof          BigInt                   @default(0)
  importedXof             BigInt                   @default(0)
  alreadyRecordedXof      BigInt                   @default(0)
  excludedXof             BigInt                   @default(0)
  /// Signed, explicitly reviewed difference between source controls and posted/excluded cash.
  reviewedAdjustmentXof   BigInt                   @default(0)
  errorSummary            Json?
  note                    String?
  createdById             String
  createdBy               Person                   @relation("PaymentImportBatchCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  importedAt              DateTime?
  payments                Payment[]
  legacyCohortImportBatch LegacyCohortImportBatch?

  @@index([status, createdAt])
  @@index([createdById, createdAt])
}

/// One reviewed reconciliation pass over an authoritative paid-to-date
/// workbook. The workbook hash is deliberately non-unique: later manifests may
/// resolve held rows, while manifestSha256 anchors exact replay to a no-op.
model PaymentBalanceImportBatch {
  id                     String                    @id @default(uuid())
  sourceFileName         String
  sourceSha256           String
  sourceExtractionSha256 String
  manifestSha256         String                    @unique
  confirmationPlanSha256 String
  status                 PaymentImportBatchStatus  @default(pending)
  academicYearLabel      String
  /// Reviewed date through which the source paid-to-date balance is
  /// authoritative. This is not an individual Payment settlement timestamp.
  sourceAsOfDate         DateTime                  @db.Date
  sourceSheet            String
  sourceRowCount         Int
  sourcePaidTotalXof     BigInt
  importedRows           Int                       @default(0)
  alreadyReconciledRows  Int                       @default(0)
  previouslyImportedRows Int                       @default(0)
  heldRows               Int                       @default(0)
  resolvedSourcePaidXof  BigInt                    @default(0)
  heldSourcePaidXof      BigInt                    @default(0)
  baselineLedgerPaidXof  BigInt                    @default(0)
  importedDeltaXof       BigInt                    @default(0)
  errorSummary           Json?
  createdById            String
  createdBy              Person                    @relation("PaymentBalanceImportBatchCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  importedAt             DateTime?
  rows                   PaymentBalanceImportRow[]

  @@index([sourceSha256, createdAt])
  @@index([sourceAsOfDate])
  @@index([status, createdAt])
  @@index([createdById, createdAt])
}

/// Durable, name-free provenance for every physical row in a paid-to-date
/// workbook. sourceClaimSha256 is populated by the first pass that resolves the
/// row (cash post or already-reconciled proof), making remapping or a second cash
/// post impossible across later reviewed manifests.
model PaymentBalanceImportRow {
  id                    String                          @id @default(uuid())
  batchId               String
  batch                 PaymentBalanceImportBatch       @relation(fields: [batchId], references: [id], onDelete: Restrict)
  sourceSheet           String
  sourceRowNumber       Int
  sourceRowKey          String
  sourceRowKeySha256    String
  rowFingerprintSha256  String
  sourcePaidToDateXof   BigInt
  disposition           PaymentBalanceImportDisposition
  identityDecision      String
  matchMethod           String?
  holdCode              String?
  holdReason            String?
  studentId             String?
  student               Student?                        @relation(fields: [studentId], references: [id], onDelete: Restrict)
  invoiceId             String?
  invoice               Invoice?                        @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  invoiceRevision       Int?
  baselineLedgerPaidXof BigInt?
  deltaXof              BigInt?
  paymentId             String?                         @unique
  payment               Payment?                        @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  sourceClaimSha256     String?                         @unique
  priorImportedRowId    String?
  priorImportedRow      PaymentBalanceImportRow?        @relation("PaymentBalanceImportPriorRow", fields: [priorImportedRowId], references: [id], onDelete: Restrict)
  laterReviewedRows     PaymentBalanceImportRow[]       @relation("PaymentBalanceImportPriorRow")
  createdAt             DateTime                        @default(now())

  @@unique([batchId, sourceSheet, sourceRowNumber])
  @@unique([batchId, sourceRowKey])
  @@index([studentId])
  @@index([invoiceId])
  @@index([disposition])
  @@index([priorImportedRowId])
}

/// One reviewed, idempotent import of a legacy admissions cohort. The workbook
/// stays outside the application; immutable coordinates, fingerprints, legacy
/// IDs, and authoritative record links remain as durable provenance.
model LegacyCohortImportBatch {
  id                     String                     @id @default(uuid())
  sourceFileName         String
  sourceSha256           String                     @unique
  sourceExtractionSha256 String
  manifestSha256         String                     @unique
  confirmationPlanSha256 String
  status                 PaymentImportBatchStatus   @default(pending)
  academicYearId         String
  academicYear           AcademicYear               @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  sourceRowCount         Int
  personCount            Int
  paymentCount           Int
  sourcePaidTotalXof     BigInt                     @default(0)
  importedPaymentXof     BigInt                     @default(0)
  notificationPolicy     String
  paymentImportBatchId   String?                    @unique
  paymentImportBatch     PaymentImportBatch?        @relation(fields: [paymentImportBatchId], references: [id], onDelete: Restrict)
  createdById            String
  createdBy              Person                     @relation("LegacyCohortImportBatchCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  importedAt             DateTime?
  people                 LegacyCohortImportPerson[]
  rows                   LegacyCohortImportRow[]

  @@index([academicYearId, status])
  @@index([createdById, createdAt])
}

/// One explicit grouping decision. legacyStudentNo is the permanent F-ID and
/// never consumes the normal StudentNumberSequence used by future applicants.
model LegacyCohortImportPerson {
  id                       String                    @id @default(uuid())
  batchId                  String
  batch                    LegacyCohortImportBatch   @relation(fields: [batchId], references: [id], onDelete: Restrict)
  personKey                String
  groupDigestSha256        String
  legacyStudentNo          String
  applicantId              String                    @unique
  applicant                Applicant                 @relation(fields: [applicantId], references: [id], onDelete: Restrict)
  studentId                String                    @unique
  student                  Student                   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  invoiceId                String                    @unique
  invoice                  Invoice                   @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  onboardingStatusAtImport ApplicantOnboardingStatus
  createdAt                DateTime                  @default(now())
  rows                     LegacyCohortImportRow[]

  @@unique([batchId, personKey])
  @@unique([batchId, legacyStudentNo])
  @@index([legacyStudentNo])
}

/// Immutable source-row provenance. Repeated physical rows may belong to one
/// person/payment only when the reviewed manifest says so explicitly.
model LegacyCohortImportRow {
  id                    String                   @id @default(uuid())
  batchId               String
  batch                 LegacyCohortImportBatch  @relation(fields: [batchId], references: [id], onDelete: Restrict)
  personRecordId        String
  personRecord          LegacyCohortImportPerson @relation(fields: [personRecordId], references: [id], onDelete: Restrict)
  sourceSheet           String
  sourceRowNumber       Int
  rowFingerprintSha256  String
  sourceLegacyStudentNo String?
  sourceLabel           String
  disposition           String
  paymentId             String?
  payment               Payment?                 @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  duplicateOfId         String?
  duplicateOf           LegacyCohortImportRow?   @relation("LegacyCohortRowDuplicate", fields: [duplicateOfId], references: [id], onDelete: Restrict)
  duplicates            LegacyCohortImportRow[]  @relation("LegacyCohortRowDuplicate")
  createdAt             DateTime                 @default(now())

  @@unique([batchId, sourceSheet, sourceRowNumber])
  @@unique([batchId, rowFingerprintSha256])
  @@index([personRecordId])
  @@index([paymentId])
  @@index([sourceLegacyStudentNo])
}

/// Authoritative package component carried by one invoice. Amounts always reconcile
/// to Invoice.totalAmount for positive standard/custom charges.
model InvoiceComponent {
  id                  String                       @id @default(uuid())
  invoiceId           String
  invoice             Invoice                      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  /// Stable catalog snapshot. `kind` remains the immutable component key on an invoice.
  scheduleComponentId String?
  scheduleComponent   FeeScheduleComponent?        @relation(fields: [scheduleComponentId], references: [id], onDelete: SetNull)
  kind                String
  label               String                       @default("")
  costCenterCode      String
  costCenter          CostCenter                   @relation(fields: [costCenterCode], references: [code])
  amountXof           Int
  allocations         PaymentComponentAllocation[]
  installments        InstallmentComponent[]
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  @@unique([invoiceId, kind])
  @@index([costCenterCode])
  @@index([scheduleComponentId])
}

/// One component cell in a student's individual installment grid. The row total
/// reconciles to Installment.amountDue and each component's column total
/// reconciles to InvoiceComponent.amountXof.
model InstallmentComponent {
  id                 String           @id @default(uuid())
  installmentId      String
  installment        Installment      @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  invoiceComponentId String
  invoiceComponent   InvoiceComponent @relation(fields: [invoiceComponentId], references: [id], onDelete: Cascade)
  amountDue          Int
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([installmentId, invoiceComponentId])
  @@index([invoiceComponentId])
}

/// Explicit per-student selection relative to the approved package defaults.
/// Absence means inherit `defaultSelected`; this preserves future global updates.
model InvoiceComponentOverride {
  id           String   @id @default(uuid())
  invoiceId    String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  componentKey String
  included     Boolean
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([invoiceId, componentKey])
  @@index([componentKey])
}

/// Exact component split frozen at settlement. A refund reverses these same rows
/// via refundedAmountXof instead of recalculating from current package proportions.
model PaymentComponentAllocation {
  id                 String           @id @default(uuid())
  paymentId          String
  payment            Payment          @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceComponentId String
  invoiceComponent   InvoiceComponent @relation(fields: [invoiceComponentId], references: [id], onDelete: Restrict)
  amountXof          Int
  refundedAmountXof  Int              @default(0)
  createdAt          DateTime         @default(now())

  @@unique([paymentId, invoiceComponentId])
  @@index([invoiceComponentId])
}

/**
 * A PI-SPI request-to-pay we pushed at a payer's alias.
 * Mirrors PaymentSubmission's polymorphic target (invoice | payment link | applicant
 * fee). `txId` is our own reference and `end2endId` is the rail-wide one carried on
 * webhooks — both are unique so a replayed notification can never settle twice.
 */
model PiSpiRequest {
  id               String             @id @default(uuid())
  txId             String             @unique
  end2endId        String?            @unique
  status           PiSpiRequestStatus @default(initiated)
  statusReason     String?
  source           String // student_portal | public_bill | payment_link | application_fee
  payerAlias       String
  payerName        String?
  payerCountry     String?
  amountXof        Int
  settledAmountXof Int?
  motif            String
  studentId        String?
  student          Student?           @relation(fields: [studentId], references: [id])
  invoiceId        String?
  invoice          Invoice?           @relation(fields: [invoiceId], references: [id])
  paymentId        String?            @unique
  payment          Payment?           @relation(fields: [paymentId], references: [id])
  paymentLinkId    String?
  paymentLink      PaymentLink?       @relation(fields: [paymentLinkId], references: [id])
  applicantId      String?
  applicant        Applicant?         @relation(fields: [applicantId], references: [id])
  expiresAt        DateTime?
  settledAt        DateTime?
  lastCheckedAt    DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([studentId])
  @@index([invoiceId])
  @@index([paymentLinkId])
  @@index([applicantId])
}

model PaymentSubmission {
  id                         String                  @id @default(uuid())
  resumeToken                String?                 @unique
  activeKey                  String?                 @unique
  status                     PaymentSubmissionStatus @default(awaiting_proof)
  auditStatus                PaymentAuditStatus      @default(unreviewed)
  method                     PaymentMethod           @default(wire)
  source                     String
  studentId                  String?
  student                    Student?                @relation(fields: [studentId], references: [id])
  invoiceId                  String?
  invoice                    Invoice?                @relation(fields: [invoiceId], references: [id])
  paymentId                  String?                 @unique
  payment                    Payment?                @relation(fields: [paymentId], references: [id])
  paymentLinkId              String?
  paymentLink                PaymentLink?            @relation(fields: [paymentLinkId], references: [id])
  applicantId                String?
  applicant                  Applicant?              @relation(fields: [applicantId], references: [id])
  diningOrderId              String?
  diningOrder                DiningOrder?            @relation(fields: [diningOrderId], references: [id])
  submittedAmountXof         Int
  confirmedAmountXof         Int?
  contactEmail               String
  submittedById              String?
  submittedBy                Person?                 @relation("PaymentSubmissionInitiator", fields: [submittedById], references: [id], onDelete: SetNull)
  submittedByEmail           String?
  proofObjectKey             String?
  proofFileName              String?
  proofMimeType              String?
  proofSize                  Int?
  payerProofSubmittedAt      DateTime?
  bankSnapshot               Json
  bankReference              String?
  confirmationNote           String?
  verificationProofObjectKey String?
  verificationProofFileName  String?
  verificationProofMimeType  String?
  verificationProofSize      Int?
  reviewedById               String?
  reviewedBy                 Person?                 @relation("PaymentSubmissionVerifier", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedByName             String?
  reviewedByEmail            String?
  reviewedAt                 DateTime?
  rejectionReason            String?
  auditedById                String?
  auditedBy                  Person?                 @relation("PaymentSubmissionAuditor", fields: [auditedById], references: [id], onDelete: SetNull)
  auditedByName              String?
  auditedByEmail             String?
  auditedAt                  DateTime?
  auditNote                  String?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt

  @@index([status, createdAt])
  @@index([auditStatus, reviewedAt])
  @@index([studentId])
  @@index([invoiceId])
  @@index([paymentLinkId])
  @@index([applicantId])
  @@index([diningOrderId])
  @@map("WireTransferSubmission")
}

model PaymentAllocation {
  id            String      @id @default(uuid())
  paymentId     String
  payment       Payment     @relation(fields: [paymentId], references: [id])
  installmentId String
  installment   Installment @relation(fields: [installmentId], references: [id])
  amount        Int

  @@index([paymentId])
  @@index([installmentId])
}

// Idempotent webhook processing: each delivered IPN is recorded once by its token.
model WebhookEvent {
  id          String   @id @default(uuid())
  provider    String   @default("paytech")
  token       String   @unique
  paymentRef  String?
  payload     Json
  processedAt DateTime @default(now())

  @@index([paymentRef])
}

model AuditLog {
  id        String   @id @default(uuid())
  entity    String
  entityId  String
  action    String
  actorId   String?
  data      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// Public marketing-site content managed by the site CMS (communications role).
// Singleton row (key = "site"). Holds the CMS override document in two states:
// draftJson (work in progress) and publishedJson (what the live vitrine serves).
model SiteContent {
  id            String    @id @default(uuid())
  key           String    @unique
  draftJson     Json
  publishedJson Json?
  // Capability token for cross-domain draft preview (rotated on each Preview request).
  previewToken  String?
  updatedById   String?
  updatedAt     DateTime  @updatedAt
  publishedById String?
  publishedAt   DateTime?
}

// CMS-authored news articles, published to the public site's News section + article pages.
model NewsArticle {
  id          String   @id @default(uuid())
  slug        String   @unique
  titleEn     String
  titleFr     String
  excerptEn   String
  excerptFr   String
  bodyEn      String
  bodyFr      String
  imageUrl    String?
  // Optional outbound link — when set, the card opens this instead of the in-app article.
  externalUrl String?
  tag         String?
  date        String
  published   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, sortOrder])
}

// Generic admin-editable settings (key -> JSON). E.g. application_notification_recipients.
model AppSetting {
  key       String   @id
  valueJson Json
  updatedAt DateTime @updatedAt
}

// "Contact us" submissions from the public site, read in the CMS inbox.
model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Applicant {
  id                            String                    @id @default(uuid())
  firstName                     String
  lastName                      String
  email                         String
  programCode                   String?
  stage                         String                    @default("submitted") // submitted|review|interview|offer|accepted|rejected
  // Admissions acceptance and SIS activation are deliberately separate. Existing
  // accepted rows remain not_started until an administrator runs the reviewed flow.
  onboardingStatus              ApplicantOnboardingStatus @default(not_started)
  studentId                     String?                   @unique
  student                       Student?                  @relation("ApplicantStudent", fields: [studentId], references: [id], onDelete: Restrict)
  admissionAcademicYearId       String?
  admissionAcademicYear         AcademicYear?             @relation("ApplicantAdmissionAcademicYear", fields: [admissionAcademicYearId], references: [id], onDelete: SetNull)
  enrollmentInvoiceId           String?                   @unique
  enrollmentInvoice             Invoice?                  @relation("ApplicantEnrollmentInvoice", fields: [enrollmentInvoiceId], references: [id], onDelete: Restrict)
  requiredEnrollmentCashXof     Int?
  activeOnboardingPaymentLinkId String?                   @unique
  activeOnboardingPaymentLink   PaymentLink?              @relation("ApplicantActiveOnboardingPaymentLink", fields: [activeOnboardingPaymentLinkId], references: [id], onDelete: SetNull)
  onboardingPaymentLinks        PaymentLink[]             @relation("ApplicantOnboardingPaymentLinks")
  activatedByPaymentId          String?                   @unique
  activatedByPayment            Payment?                  @relation("ApplicantActivationPayment", fields: [activatedByPaymentId], references: [id], onDelete: Restrict)
  acceptedAt                    DateTime?
  paymentPendingAt              DateTime?
  enrolledAt                    DateTime?
  onboardingCancelledAt         DateTime?
  // Only hashes are persisted. While payment is pending the capability has no
  // expiry; enrollment makes it read-only and sets an expiry 30 days later.
  statusTokenHash               String?                   @unique
  statusTokenExpiresAt          DateTime?
  statusTokenRevokedAt          DateTime?
  acceptanceEmailSentAt         DateTime?
  studentInviteSentAt           DateTime?
  score                         Int? // BAC score (0–20)
  country                       String?
  // Application fee settles after Finance verifies both payment proofs.
  feePaid                       Boolean                   @default(false)
  // --- Full application intake (SIS redesign; all optional) ---
  phone                         String?
  dateOfBirth                   DateTime?
  gender                        String?
  nationality                   String?
  city                          String?
  // "high-school" | "transfer" — decides whether `school` reads as HS or prior university.
  origin                        String?
  school                        String?
  priorGpa                      String? // free text: "17.2/20" (BAC) or "3.4/4" (transfer)
  // Guardian contact captured on the application. NOT a portal Guardian account —
  // that is provisioned separately by the registrar after enrolment.
  parentName                    String?
  parentPhone                   String?
  parentEmail                   String?
  allergies                     String?
  source                        String? // how they heard about DAUST
  essay                         String?
  term                          String? // intake term, e.g. "Fall 2026"
  piSpiRequests                 PiSpiRequest[]
  paymentSubmissions            PaymentSubmission[]
  legacyCohortImport            LegacyCohortImportPerson?
  createdAt                     DateTime                  @default(now())
  notes                         AdmissionNote[]

  @@index([stage])
  @@index([onboardingStatus])
  @@index([admissionAcademicYearId])
}

/// Per-applicant notes thread. Authored by admissions officers (or admins) and
/// scoped to the pre-acceptance pipeline. Body is plain text, rendered only
/// inside the authenticated portal shell. Notes are hard-deletable; the
/// audit log retains the metadata but not the body.
model AdmissionNote {
  id          String    @id @default(uuid())
  applicantId String
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  authorId    String
  author      Person    @relation("AdmissionNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  kind        String    @default("general")
  body        String
  pinned      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  editedAt    DateTime?

  @@index([applicantId, createdAt])
  @@index([applicantId, pinned])
}

/// Monotonic, database-backed yearly counter for permanent Student IDs. The
/// value is advanced inside the acceptance transaction and is never decremented.
model StudentNumberSequence {
  academicYearStart Int      @id
  nextValue         Int
  updatedAt         DateTime @updatedAt
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  body      String
  category  String
  audience  String   @default("all") // all | student | faculty | staff
  author    String?
  createdAt DateTime @default(now())

  @@index([audience])
}

// --- Academic core: Course is the catalog entity; Section is a term offering; Enrollment is the join. ---

model Department {
  id       String    @id @default(uuid())
  code     String    @unique
  name     String
  head     String? // department chair, free text (no faculty FK yet)
  programs Program[]
  courses  Course[]
}

model Program {
  id           String               @id @default(uuid())
  code         String               @unique
  name         String
  departmentId String
  department   Department           @relation(fields: [departmentId], references: [id])
  students     Student[]
  // Display/reference metadata (editable via admin). `tuition` is reference only —
  // actual billing uses the standard FEE_STRUCTURE amount, not this.
  degree       String? // e.g. "B.Sc.", "M.Sc.", "MBA"
  school       String? // e.g. "Engineering"
  tuition      Int? // reference annual tuition (XOF)
  color        String? // accent hex for cards
  // --- SIS redesign ---
  curricula    Curriculum[]
  requirements ProgramRequirement[]
}

model Course {
  id                   String                @id @default(uuid())
  code                 String                @unique
  title                String
  credits              Int
  // Catalog lifecycle + presentation (SIS design's Course modal).
  status               String? // active | draft
  description          String?
  semestersOffered     String? // comma-joined subset of fall,spring,summer
  departmentId         String
  department           Department            @relation(fields: [departmentId], references: [id])
  sections             Section[]
  /// Which degree-audit requirement bucket this course satisfies (e.g. "Mathematics").
  /// Distinct from the owning department: one department teaches courses that count
  /// toward several different requirements. Null falls back to the department name,
  /// then to the elective bucket.
  requirementCategory  String?
  // Self many-to-many: a course's prerequisite courses.
  // Superseded by CoursePrerequisite (which carries a minimum grade); kept until the
  // enrolment prereq check is migrated over, then dropped.
  prerequisites        Course[]              @relation("CoursePrereq")
  requiredFor          Course[]              @relation("CoursePrereq")
  // --- Rule engine (SIS redesign) ---
  rule                 CourseRule?
  prereqRules          CoursePrerequisite[]  @relation("RuleCourse")
  prereqFor            CoursePrerequisite[]  @relation("PrereqCourse")
  coreqRules           CourseCorequisite[]   @relation("CoreqRuleCourse")
  coreqFor             CourseCorequisite[]   @relation("CoreqCourse")
  curriculumSlots      CurriculumEntry[]
  transcriptEntries    TranscriptEntry[]
  gradeSubmissionItems GradeSubmissionItem[]
}

model Section {
  id                  String                     @id @default(uuid())
  courseId            String
  course              Course                     @relation(fields: [courseId], references: [id])
  termId              String
  term                Term                       @relation(fields: [termId], references: [id])
  instructorId        String?
  instructor          Person?                    @relation("Instructor", fields: [instructorId], references: [id])
  sectionCode         String
  capacity            Int
  days                String // e.g. "MWF"
  startTime           String // "10:00"
  endTime             String // "11:00"
  room                String?
  enrollments         Enrollment[]
  assignments         Assignment[]
  materials           SectionMaterial[]
  posts               SectionPost[]
  // --- SIS redesign ---
  // Which scale this section is graded on. Null = the institution default (letter).
  gradingSchemeId     String?
  gradingScheme       GradingScheme?             @relation(fields: [gradingSchemeId], references: [id])
  gradeSubmission     GradeSubmission?
  // Registration gate: closed sections are not offered to students.
  status              String                     @default("open") // open | closed
  evaluationSchedules CourseEvaluationSchedule[]
  evaluationResponses CourseEvaluationResponse[]

  @@unique([courseId, termId, sectionCode])
  @@index([termId])
}

model Enrollment {
  id                   String                    @id @default(uuid())
  studentId            String
  student              Student                   @relation(fields: [studentId], references: [id])
  sectionId            String
  section              Section                   @relation(fields: [sectionId], references: [id])
  status               EnrollmentStatus          @default(enrolled)
  grade                String?
  enrolledAt           DateTime                  @default(now())
  attendance           AttendanceRecord[]
  submissions          Submission[]
  transcriptEntry      TranscriptEntry?
  gradeSubmissionItems GradeSubmissionItem[]
  evaluationReceipts   CourseEvaluationReceipt[]

  @@unique([studentId, sectionId])
  @@index([sectionId])
  @@index([studentId])
}

model AttendanceRecord {
  id           String           @id @default(uuid())
  enrollmentId String
  enrollment   Enrollment       @relation(fields: [enrollmentId], references: [id])
  sectionId    String
  date         DateTime // class day (date only)
  status       AttendanceStatus @default(present)
  createdAt    DateTime         @default(now())
  /// Free-form reason, narrowed by CHECK to: null | "sick" | "infirmary_emergency" | "admin_override".
  /// Pinned by a CHECK constraint in the migration; out-of-set inserts fail.
  reason       String?
  /// Who wrote this row. CHECK-pinned to: faculty | infirmary | admin. Defaults to
  /// `faculty` so existing rows are unaffected.
  source       String           @default("faculty")
  notedById    String?
  notedBy      Person?          @relation("AttendanceNotedBy", fields: [notedById], references: [id], onDelete: SetNull)

  @@unique([enrollmentId, date])
  @@index([sectionId, date])
  @@index([source, date])
}

// Coursework: an Assignment belongs to a Section; a Submission is the Enrollment<->Assignment join
// carrying the student's work + the faculty's score/feedback. Weighted scores feed a section grade
// suggestion, but the final letter grade stays the faculty's explicit call (Enrollment.grade).
model Assignment {
  id          String         @id @default(uuid())
  sectionId   String
  section     Section        @relation(fields: [sectionId], references: [id])
  title       String
  description String?
  type        AssignmentType @default(homework)
  maxPoints   Int            @default(100)
  // Percent weight toward the final grade; 0 = practice/ungraded.
  weight      Int            @default(0)
  dueDate     DateTime
  createdAt   DateTime       @default(now())
  submissions Submission[]

  @@index([sectionId])
}

model Submission {
  id           String           @id @default(uuid())
  assignmentId String
  assignment   Assignment       @relation(fields: [assignmentId], references: [id])
  enrollmentId String
  enrollment   Enrollment       @relation(fields: [enrollmentId], references: [id])
  status       SubmissionStatus @default(submitted)
  text         String?
  fileUrl      String?
  fileName     String?
  score        Int?
  feedback     String?
  submittedAt  DateTime         @default(now())
  gradedAt     DateTime?

  @@unique([assignmentId, enrollmentId])
  @@index([assignmentId])
  @@index([enrollmentId])
}

// --- Messaging: direct/threaded conversations between people (student<->faculty<->staff). ---

model Thread {
  id           String              @id @default(uuid())
  subject      String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  participants ThreadParticipant[]
  messages     Message[]

  @@index([updatedAt])
}

model ThreadParticipant {
  id         String    @id @default(uuid())
  threadId   String
  thread     Thread    @relation(fields: [threadId], references: [id])
  personId   String
  person     Person    @relation(fields: [personId], references: [id])
  lastReadAt DateTime?

  @@unique([threadId, personId])
  @@index([personId])
}

model Message {
  id        String   @id @default(uuid())
  threadId  String
  thread    Thread   @relation(fields: [threadId], references: [id])
  senderId  String
  sender    Person   @relation(fields: [senderId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([threadId])
}

// --- Campus: events + library catalog. ---

model Event {
  id          String    @id @default(uuid())
  title       String
  description String?
  location    String?
  category    String    @default("Campus") // Campus | Academics | Career | Sports | Arts
  organizer   String?
  attendees   Int?
  budgetXof   Int?
  status      String    @default("upcoming") // planning | upcoming | past
  startsAt    DateTime
  endsAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([startsAt])
}

model LibraryResource {
  id         String  @id @default(uuid())
  title      String
  author     String?
  kind       String  @default("book") // book | journal | ebook | database
  subject    String?
  callNumber String?
  available  Boolean @default(true)

  @@index([title])
}

// --- Dining: meal plans, proof-paid weekend orders, and entrance scans. ---

enum MealPeriod {
  breakfast
  lunch
  dinner
}

enum MealPlanType {
  none
  half
  full
}

enum DiningOrderStatus {
  cart
  paid
  preparing
  ready
  collected
  cancelled
}

enum ScanResult {
  served
  turned_away
}

model MealPlan {
  id        String       @id @default(uuid())
  studentId String       @unique
  student   Student      @relation(fields: [studentId], references: [id])
  type      MealPlanType @default(none)
  term      String
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
}

model MenuItem {
  id          String   @id @default(uuid())
  name        String
  description String?
  category    String   @default("weekend") // breakfast | lunch | dinner | weekend
  priceXof    Int      @default(0)
  imageUrl    String?
  available   Boolean  @default(true)
  createdAt   DateTime @default(now())

  orderItems DiningOrderItem[]
}

model DiningOrder {
  id                 String              @id @default(uuid())
  studentId          String
  student            Student             @relation(fields: [studentId], references: [id])
  status             DiningOrderStatus   @default(cart)
  totalXof           Int                 @default(0)
  pickupAt           DateTime?
  createdAt          DateTime            @default(now())
  items              DiningOrderItem[]
  paymentSubmissions PaymentSubmission[]

  @@index([studentId])
  @@index([status])
}

model DiningOrderItem {
  id         String      @id @default(uuid())
  orderId    String
  order      DiningOrder @relation(fields: [orderId], references: [id])
  menuItemId String
  menuItem   MenuItem    @relation(fields: [menuItemId], references: [id])
  qty        Int         @default(1)
  priceXof   Int

  @@index([orderId])
}

model DiningScan {
  id        String     @id @default(uuid())
  studentId String
  student   Student    @relation(fields: [studentId], references: [id])
  period    MealPeriod
  date      DateTime // date only
  result    ScanResult
  reason    String?
  createdAt DateTime   @default(now())

  @@unique([studentId, period, date])
  @@index([date, period])
}

// --- Student Affairs: housing, roommate matching, conduct, clubs, co-curricular budget. ---

enum HousingStatus {
  pending
  assigned
}

enum ConductStage {
  intake
  investigation
  mediation
  hearing
  resolved
}

enum ConductSeverity {
  low
  med
  high
}

model Hall {
  id          String              @id @default(uuid())
  name        String              @unique
  kind        String // "First-year · Mixed", etc.
  beds        Int
  color       String              @default("#153b6a")
  assignments HousingAssignment[]
  tickets     MaintenanceTicket[]
}

model HousingAssignment {
  id        String        @id @default(uuid())
  studentId String        @unique
  student   Student       @relation(fields: [studentId], references: [id])
  hallId    String?
  hall      Hall?         @relation(fields: [hallId], references: [id])
  room      String?
  status    HousingStatus @default(pending)
  note      String?
  updatedAt DateTime      @updatedAt
}

model RoommateProfile {
  id        String  @id @default(uuid())
  studentId String  @unique
  student   Student @relation(fields: [studentId], references: [id])
  sleep     String // early | late
  tidy      String // very | moderate | relaxed
  social    String // low | moderate | high
  study     String // quiet | music | flexible
}

model ConductCase {
  id       String          @id @default(uuid())
  subject  String
  type     String
  stage    ConductStage    @default(intake)
  severity ConductSeverity @default(med)
  officer  String?
  openedAt DateTime        @default(now())
  slaDueAt DateTime?

  @@index([stage])
}

model Club {
  id        String   @id @default(uuid())
  name      String
  category  String
  members   Int      @default(0)
  budgetXof Int      @default(0)
  status    String   @default("active") // active | review
  lead      String?
  createdAt DateTime @default(now())
}

model CoCurricularLine {
  id           String @id @default(uuid())
  line         String @unique
  allocatedXof Int    @default(0)
  spentXof     Int    @default(0)
  color        String @default("#153b6a")
}

// --- Innovation Studio: 7-phase project tracker (student build + admin review). ---

enum ProjectPhase {
  proposal
  research
  design
  build
  test
  showcase
  final
}

model Project {
  id                 String              @id @default(uuid())
  name               String
  description        String?
  phase              ProjectPhase        @default(proposal)
  advisor            String?
  status             String              @default("active") // active | graded | archived
  grade              String?
  createdAt          DateTime            @default(now())
  members            ProjectMember[]
  tasks              ProjectTask[]
  submissions        ProjectSubmission[]
  globalTaskStatuses ProjectGlobalTask[]
}

model ProjectMember {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])
  personId  String
  person    Person  @relation(fields: [personId], references: [id])
  role      String  @default("member")

  @@unique([projectId, personId])
  @@index([personId])
}

model ProjectTask {
  id        String       @id @default(uuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id])
  title     String
  phase     ProjectPhase
  status    String       @default("todo") // todo | done
  dueDate   DateTime?

  @@index([projectId])
}

model ProjectSubmission {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  title     String
  kind      String   @default("Document") // Document | Video | Demo | Poster
  fileUrl   String?
  fileName  String?
  status    String   @default("submitted") // submitted | reviewed
  grade     String?
  feedback  String?
  createdAt DateTime @default(now())

  @@index([projectId])
}

// --- HR-lite: leave requests + room/lab bookings. Payslips derive from salary Expenses. ---

enum LeaveStatus {
  pending
  approved
  rejected
}

model LeaveRequest {
  id        String      @id @default(uuid())
  personId  String
  type      String // Annual | Sick | Personal | Conference
  startDate DateTime
  endDate   DateTime
  reason    String?
  status    LeaveStatus @default(pending)
  createdAt DateTime    @default(now())

  @@index([personId])
}

model RoomBooking {
  id        String   @id @default(uuid())
  personId  String
  room      String
  date      DateTime
  startTime String
  endTime   String
  purpose   String?
  status    String   @default("confirmed")
  createdAt DateTime @default(now())

  @@index([personId])
  @@index([room, date])
}

// --- Director-configurable money settings (admin UI, audit-logged, seeded from shared constants). ---

model FeeItem {
  key       String  @id // tuition | housing | cafeteria | application_fee | insurance
  label     String
  minXof    Int
  maxXof    Int? // null = fixed amount, otherwise a min–max range
  period    String // year | semester | one-time
  note      String?
  sortOrder Int     @default(0)
}

model ScholarshipTier {
  id       String  @id @default(uuid())
  minScore Float // BAC threshold (inclusive)
  pct      Int // tuition discount percent
  band     String
  note     String?
}

// --- Track D additions: course materials/posts, SA boards, innovation global tasks. ---

model SectionMaterial {
  id        String           @id @default(uuid())
  sectionId String
  section   Section          @relation(fields: [sectionId], references: [id])
  title     String
  kind      String           @default("Document") // Document | Slides | Video | Link
  // Taxonomy the course-materials screens group by.
  category  MaterialCategory @default(resources)
  fileUrl   String?
  fileName  String?
  published Boolean          @default(true)
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())

  @@index([sectionId, sortOrder])
}

model SectionPost {
  id        String   @id @default(uuid())
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id])
  title     String
  body      String
  author    String?
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([sectionId])
}

// International student onboarding checklist (SA design).
model OnboardingCase {
  id          String    @id @default(uuid())
  name        String
  origin      String
  kind        String // Exchange | Graduate | Degree-seeking
  visaStatus  String    @default("Pending") // Valid | Pending | Action needed
  arrivalDate DateTime?
  tasks       Json // [{ label: string, done: boolean }]
  createdAt   DateTime  @default(now())
}

model AbroadProgram {
  id         String    @id @default(uuid())
  name       String
  kind       String // Study abroad | Internship
  partner    String
  seatsTotal Int
  seatsTaken Int       @default(0)
  deadline   DateTime?
  status     String    @default("open") // open | full | closed
}

model MaintenanceTicket {
  id       String   @id @default(uuid())
  hallId   String
  hall     Hall     @relation(fields: [hallId], references: [id])
  room     String?
  kind     String
  note     String?
  severity String   @default("low") // low | med | high
  status   String   @default("open") // open | resolved
  openedAt DateTime @default(now())

  @@index([hallId])
}

// Innovation "passes" every project must complete (design: AdminGlobalTasks).
model GlobalTask {
  id       String              @id @default(uuid())
  title    String
  kind     String              @default("Document")
  dueDate  DateTime?
  statuses ProjectGlobalTask[]
}

model ProjectGlobalTask {
  id           String     @id @default(uuid())
  globalTaskId String
  globalTask   GlobalTask @relation(fields: [globalTaskId], references: [id])
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id])
  done         Boolean    @default(false)

  @@unique([globalTaskId, projectId])
}

// Bursar-generated payment link: any amount/purpose, settled by PI-SPI or Finance review.
// Optional invoiceId puts the money on the normal tuition rail (Payment + allocations).
model PaymentLink {
  id                    String              @id @default(uuid())
  token                 String              @unique // unguessable public slug
  amountXof             Int
  purpose               String
  payeeName             String
  payeeMeta             String? // e.g. "DA24003 · Computer Science"
  studentId             String?
  invoiceId             String?
  costCenterCode        String              @default("9100")
  dueDate               DateTime?
  expiresAt             DateTime?
  status                String              @default("active") // active | paid | cancelled
  method                String? // how it was settled (wave | orange_money | card | manual)
  paidAt                DateTime?
  createdById           String?
  createdAt             DateTime            @default(now())
  onboardingApplicantId String?
  onboardingApplicant   Applicant?          @relation("ApplicantOnboardingPaymentLinks", fields: [onboardingApplicantId], references: [id], onDelete: SetNull)
  activeForApplicant    Applicant?          @relation("ApplicantActiveOnboardingPaymentLink")
  paymentSubmissions    PaymentSubmission[]
  piSpiRequests         PiSpiRequest[]

  @@index([status])
  @@index([onboardingApplicantId])
}

// ============================================================================
// SIS redesign — academic structure, rules, guardians, alerts and fee schedule.
// Mirrors design/Student information system design (1).
// ============================================================================

enum MaterialCategory {
  syllabus
  lecture_notes
  assignments
  quizzes
  resources
}

enum AcademicYearStatus {
  draft
  active
  archived
}

enum AcademicCatalogStatus {
  draft
  pending
  approved
  rejected
  cancelled
  superseded
}

/// Catalog year (e.g. "2026-2027"). Exactly one is `active` at a time; activating
/// another archives the previous one.
model AcademicYear {
  id                        String                    @id @default(uuid())
  label                     String                    @unique
  status                    AcademicYearStatus        @default(draft)
  startsOn                  DateTime?
  endsOn                    DateTime?
  terms                     Term[]
  curricula                 Curriculum[]
  events                    CalendarEvent[]
  feeSchedules              FeeSchedule[]
  operatingBudgets          OperatingBudget[]
  managementActualEntries   ManagementActualEntry[]
  expenses                  Expense[]
  students                  Student[]                 @relation("StudentCatalogYear")
  admittedApplicants        Applicant[]               @relation("ApplicantAdmissionAcademicYear")
  legacyCohortImportBatches LegacyCohortImportBatch[]
  catalogRevisions          AcademicCatalogRevision[]
  createdAt                 DateTime                  @default(now())

  @@index([status])
}

/// Immutable, director-approved academic progression and programme-requirement
/// snapshot. JSON preserves the whole reviewed catalog as one atomic revision.
model AcademicCatalogRevision {
  id                    String                @id @default(uuid())
  academicYearId        String
  academicYear          AcademicYear          @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  revision              Int
  status                AcademicCatalogStatus @default(draft)
  yearLabel             String
  startsOn              DateTime?
  endsOn                DateTime?
  defaultLevels         Json
  defaultStandingRules  Json                  @default("[{\"code\":\"academic_probation\",\"label\":\"Academic Probation\",\"minimumGpa\":0,\"order\":0,\"tone\":\"warning\"},{\"code\":\"good_standing\",\"label\":\"Good Standing\",\"minimumGpa\":2,\"order\":1,\"tone\":\"success\"},{\"code\":\"deans_list\",\"label\":\"Dean's List\",\"minimumGpa\":3.7,\"order\":2,\"tone\":\"honor\"}]")
  notYetGradedStanding  Json                  @default("{\"code\":\"not_yet_graded\",\"label\":\"Not yet graded\",\"tone\":\"neutral\"}")
  programConfigurations Json
  reason                String?
  activateYear          Boolean               @default(false)
  createdById           String?
  createdBy             Person?               @relation("AcademicCatalogCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedById          String?
  approvedBy            Person?               @relation("AcademicCatalogApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvalRequestId     String?               @unique
  approvedAt            DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@unique([academicYearId, revision])
  @@index([academicYearId, status, revision])
  @@index([createdById])
  @@index([approvedById])
}

/// A reasoned exception to the approved catalog standing policy. Computed
/// standing remains the default and resumes after clearing or expiry.
model StudentStandingOverride {
  id           String    @id @default(uuid())
  studentId    String
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  standingCode String
  reason       String
  expiresAt    DateTime?
  createdById  String?
  createdBy    Person?   @relation("StandingOverrideCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById  String?
  updatedBy    Person?   @relation("StandingOverrideUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  clearedById  String?
  clearedBy    Person?   @relation("StandingOverrideClearer", fields: [clearedById], references: [id], onDelete: SetNull)
  clearedAt    DateTime?
  clearReason  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([studentId, clearedAt, expiresAt])
  @@index([createdById])
  @@index([clearedById])
}

model CalendarEvent {
  id             String       @id @default(uuid())
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  title          String
  // registration | holiday | exam | deadline | event
  type           String       @default("event")
  startsOn       DateTime
  endsOn         DateTime?
  note           String?

  @@index([academicYearId])
}

/// A program's course map for a catalog year: which courses sit in which
/// year-of-study and semester. Drives the Programs & Curriculum editor.
model Curriculum {
  id             String            @id @default(uuid())
  programId      String
  program        Program           @relation(fields: [programId], references: [id])
  academicYearId String
  academicYear   AcademicYear      @relation(fields: [academicYearId], references: [id])
  entries        CurriculumEntry[]
  updatedAt      DateTime          @updatedAt

  @@unique([programId, academicYearId])
}

model CurriculumEntry {
  id           String     @id @default(uuid())
  curriculumId String
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  yearIndex    Int
  semester     String
  courseId     String
  course       Course     @relation(fields: [courseId], references: [id])
  position     Int        @default(0)

  @@index([curriculumId])
}

/// Degree-audit requirement bucket, e.g. "Core Engineering" needs 40 credits.
/// Fulfilment is computed from completed/in-progress enrolments, never stored.
model ProgramRequirement {
  id              String  @id @default(uuid())
  programId       String
  program         Program @relation(fields: [programId], references: [id])
  catalogYear     String
  category        String
  requiredCredits Int
  position        Int     @default(0)

  @@unique([programId, catalogYear, category])
}

/// Per-course registration rules. Enforced server-side at enrolment — the design
/// prototype displays these but never checks them.
model CourseRule {
  id               String  @id @default(uuid())
  courseId         String  @unique
  course           Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  standingRequired String?
  majorRestriction String?
  capacity         Int?
  waitlistEnabled  Boolean @default(false)
}

model CoursePrerequisite {
  id             String  @id @default(uuid())
  courseId       String
  course         Course  @relation("RuleCourse", fields: [courseId], references: [id], onDelete: Cascade)
  prereqCourseId String
  prereqCourse   Course  @relation("PrereqCourse", fields: [prereqCourseId], references: [id])
  /// Minimum letter grade required in the prerequisite, e.g. "C". Null = pass.
  minGrade       String?

  @@unique([courseId, prereqCourseId])
}

model CourseCorequisite {
  id            String @id @default(uuid())
  courseId      String
  course        Course @relation("CoreqRuleCourse", fields: [courseId], references: [id], onDelete: Cascade)
  coreqCourseId String
  coreqCourse   Course @relation("CoreqCourse", fields: [coreqCourseId], references: [id])

  @@unique([courseId, coreqCourseId])
}

/// Grading scale (Standard Letter 4.00, Pass/Fail, IEP levels). GPA is always
/// derived from these points; it is never stored on the student.
model GradingScheme {
  id        String          @id @default(uuid())
  key       String          @unique
  name      String
  isDefault Boolean         @default(false)
  rows      GradeScaleRow[]
  sections  Section[]
}

model GradeScaleRow {
  id                  String        @id @default(uuid())
  schemeId            String
  scheme              GradingScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  grade               String
  /// Null for non-numeric scales (Pass/Fail, IEP) which carry no GPA weight.
  points              Float?
  minScore            Int?
  maxScore            Int?
  position            Int           @default(0)
  // Explicit policy keeps non-letter grades such as P/I/W from being inferred
  // from whether a numeric point value happens to be present.
  countsTowardGpa     Boolean       @default(true)
  countsTowardCredits Boolean       @default(true)

  @@index([schemeId])
}

enum GradeSubmissionStatus {
  draft
  submitted
  approved
  returned
}

enum TranscriptEntrySource {
  legacy_import
  approved_enrollment
  manual
}

enum TranscriptImportBatchStatus {
  pending
  validated
  imported
  failed
}

/// Faculty submit a section's final grades; the registrar approves before they
/// count toward GPA/transcript.
model GradeSubmission {
  id            String                @id @default(uuid())
  sectionId     String                @unique
  section       Section               @relation(fields: [sectionId], references: [id])
  status        GradeSubmissionStatus @default(draft)
  submittedById String?
  submittedAt   DateTime?
  approvedById  String?
  approvedAt    DateTime?
  note          String?
  // Incremented for every faculty submission/resubmission. GradeSubmissionItem
  // preserves the exact roster and grades reviewed for each version.
  version       Int                   @default(0)
  items         GradeSubmissionItem[]

  @@index([status])
}

/// Immutable per-student snapshot of a submitted section-grade version. The
/// registrar approves these values rather than mutable Enrollment rows.
model GradeSubmissionItem {
  id                  String           @id @default(uuid())
  gradeSubmissionId   String
  gradeSubmission     GradeSubmission  @relation(fields: [gradeSubmissionId], references: [id], onDelete: Cascade)
  version             Int
  enrollmentId        String
  enrollment          Enrollment       @relation(fields: [enrollmentId], references: [id])
  studentId           String
  student             Student          @relation(fields: [studentId], references: [id])
  courseId            String?
  course              Course?          @relation(fields: [courseId], references: [id], onDelete: SetNull)
  termId              String?
  term                Term?            @relation(fields: [termId], references: [id], onDelete: SetNull)
  courseCode          String
  courseTitle         String
  termLabel           String
  credits             Int
  grade               String?
  gradePoints         Float?
  countsTowardGpa     Boolean          @default(false)
  countsTowardCredits Boolean          @default(false)
  createdAt           DateTime         @default(now())
  transcriptEntry     TranscriptEntry?

  @@unique([gradeSubmissionId, version, enrollmentId])
  @@index([gradeSubmissionId, version])
  @@index([studentId])
  @@index([enrollmentId])
  @@index([courseId])
  @@index([termId])
}

/// One idempotent source workbook load. The source hash prevents the same file
/// from being imported twice while entry-level source keys protect row retries.
model TranscriptImportBatch {
  id              String                      @id @default(uuid())
  sourceFileName  String
  sourceSha256    String                      @unique
  sourceObjectKey String?
  status          TranscriptImportBatchStatus @default(pending)
  totalRows       Int                         @default(0)
  importedRows    Int                         @default(0)
  skippedRows     Int                         @default(0)
  errorRows       Int                         @default(0)
  errorSummary    Json?
  note            String?
  createdById     String?
  createdBy       Person?                     @relation("TranscriptImportBatchCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  importedAt      DateTime?
  entries         TranscriptEntry[]

  @@index([status, createdAt])
}

/// Canonical academic-history ledger. Snapshot fields remain authoritative even
/// when catalog courses or terms are renamed; nullable links add context when a
/// legacy row can be matched to current SIS entities.
model TranscriptEntry {
  id                    String                 @id @default(uuid())
  studentId             String
  student               Student                @relation(fields: [studentId], references: [id])
  source                TranscriptEntrySource
  sourceKey             String?                @unique
  importBatchId         String?
  importBatch           TranscriptImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  importRowNumber       Int?
  gradeSubmissionItemId String?                @unique
  gradeSubmissionItem   GradeSubmissionItem?   @relation(fields: [gradeSubmissionItemId], references: [id], onDelete: SetNull)
  enrollmentId          String?                @unique
  enrollment            Enrollment?            @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  courseId              String?
  course                Course?                @relation(fields: [courseId], references: [id], onDelete: SetNull)
  termId                String?
  term                  Term?                  @relation(fields: [termId], references: [id], onDelete: SetNull)
  courseCode            String
  courseTitle           String
  termLabel             String
  termSortKey           String?
  grade                 String
  credits               Int
  earnedCredits         Int
  gradePoints           Float?
  countsTowardGpa       Boolean                @default(true)
  countsTowardCredits   Boolean                @default(true)
  requirementCategory   String?
  note                  String?
  createdById           String?
  createdBy             Person?                @relation("TranscriptEntryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById           String?
  updatedBy             Person?                @relation("TranscriptEntryUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  voidedById            String?
  voidedBy              Person?                @relation("TranscriptEntryVoider", fields: [voidedById], references: [id], onDelete: SetNull)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  voidedAt              DateTime?
  voidReason            String?

  @@unique([importBatchId, importRowNumber])
  @@index([studentId, voidedAt, termSortKey])
  @@index([studentId, voidedAt, courseCode])
  @@index([importBatchId])
  @@index([courseId])
  @@index([termId])
}

/// Financial or advising hold. An active hold blocks course registration.
model StudentHold {
  id        String    @id @default(uuid())
  studentId String
  student   Student   @relation(fields: [studentId], references: [id])
  type      String
  reason    String?
  active    Boolean   @default(true)
  placedAt  DateTime  @default(now())
  clearedAt DateTime?

  @@index([studentId, active])
}

/// Early-alert flag raised when a student falls below the GPA/attendance
/// thresholds. `warnedAt` records that the student was notified.
model StudentAlert {
  id        String    @id @default(uuid())
  studentId String
  student   Student   @relation(fields: [studentId], references: [id])
  reason    String
  level     String    @default("warning")
  warnedAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([studentId])
}

/// A staff member's personal watchlist for early-alert monitoring. Unrelated to
/// the guardian relationship.
model StaffWatch {
  id        String   @id @default(uuid())
  personId  String
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  createdAt DateTime @default(now())

  @@unique([personId, studentId])
}

/// Links a guardian Person (kind = parent) to a student they may view. All
/// parent-facing reads authorise through this join.
model GuardianStudent {
  id         String   @id @default(uuid())
  guardianId String
  guardian   Person   @relation("GuardianOf", fields: [guardianId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  relation   String?
  createdAt  DateTime @default(now())

  @@unique([guardianId, studentId])
  @@index([studentId])
}

/// Contact details supplied by a registrar or an authoritative guardian import.
/// Kept separate from Student contact fields because one guardian may be linked
/// to several students and has one shared phone/address.
model GuardianProfile {
  guardianId String   @id
  guardian   Person   @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  phone      String?
  address    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Single-use password-setup token emailed when the registrar provisions a
/// guardian account. Hashed at rest; never stored or logged in the clear.
model GuardianInvite {
  id         String    @id @default(uuid())
  guardianId String
  guardian   Person    @relation("GuardianInvites", fields: [guardianId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([guardianId])
}

/// A student's single-use, expiring password-setup token. A verified
/// StudentActivationRequest creates one; the student-owned browser capability
/// redeems it on the public /set-password page.
model StudentInvite {
  id                String                    @id @default(uuid())
  studentPersonId   String
  person            Person                    @relation("StudentInvites", fields: [studentPersonId], references: [id], onDelete: Cascade)
  tokenHash         String                    @unique
  // Setup invites bind the capability to the reviewed login identity.
  // Nullable keeps the migration additive; null legacy rows fail closed.
  boundEmailSha256  String?
  expiresAt         DateTime
  usedAt            DateTime?
  createdAt         DateTime                  @default(now())
  activationRequest StudentActivationRequest? @relation("StudentActivationRequestInvite")

  @@index([studentPersonId])
}

/// Public student activation begins as a short-lived request. Historical rows
/// may record named approval; self-service rows bind a verified issued card.
/// Every public capability is stored only as a hash/HMAC.
model StudentActivationRequest {
  id                      String                 @id @default(uuid())
  studentPersonId         String?
  studentPerson           Person?                @relation("StudentActivationRequestStudent", fields: [studentPersonId], references: [id], onDelete: Cascade)
  accountKeyHash          String
  requestTokenHash        String                 @unique
  approvalCodeHash        String
  expiresAt               DateTime
  approvedAt              DateTime?
  approvedById            String?
  approvedBy              Person?                @relation("StudentActivationRequestApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  studentInviteId         String?                @unique
  studentInvite           StudentInvite?         @relation("StudentActivationRequestInvite", fields: [studentInviteId], references: [id], onDelete: SetNull)
  // Null for the legacy in-person pairing flow. Issued-card redemption records
  // both the method and exact one-time card without storing the plaintext code.
  verificationMethod      String?
  studentActivationCardId String?                @unique
  studentActivationCard   StudentActivationCard? @relation("StudentActivationRequestCard", fields: [studentActivationCardId], references: [id], onDelete: SetNull)
  consumedAt              DateTime?
  invalidatedAt           DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  // The migration also owns partial unique indexes for unresolved account keys,
  // real student-person IDs, and approval-code hashes. Prisma cannot express them.
  @@index([accountKeyHash])
  @@index([studentPersonId, consumedAt, invalidatedAt, expiresAt], map: "StudentActivationRequest_active_idx")
  @@index([studentPersonId, approvedAt, expiresAt], map: "StudentActivationRequest_approval_idx")
  @@index([approvedById])
  @@index([expiresAt])
}

/// One reviewed operator run that issues print-only, one-time activation cards.
/// The plaintext artifact stays outside the database; only its SHA-256 and the
/// reviewed eligibility snapshot remain as durable provenance.
model StudentActivationCardBatch {
  id                        String                  @id @default(uuid())
  confirmationPlanSha256    String                  @unique
  eligibilitySnapshotSha256 String
  expiresAt                 DateTime
  eligibleCount             Int
  generatedCount            Int
  outputSha256              String                  @unique
  status                    String                  @default("active")
  createdById               String
  createdBy                 Person                  @relation("StudentActivationCardBatchCreator", fields: [createdById], references: [id], onDelete: Restrict)
  revokedAt                 DateTime?
  revokedById               String?
  revokedBy                 Person?                 @relation("StudentActivationCardBatchRevoker", fields: [revokedById], references: [id], onDelete: Restrict)
  // Bounded non-PII reason code; allowed values are enforced by migration CHECK.
  revokeReason              String?
  createdAt                 DateTime                @default(now())
  items                     StudentActivationCard[]

  @@index([expiresAt, revokedAt])
  @@index([createdById, createdAt])
  @@index([revokedById, revokedAt])
}

/// A random 80-bit Crockford code issued to exactly one passwordless student.
/// codeHmacSha256 is domain-separated with the dedicated activation key; the
/// recoverable code exists only in the operator's mode-0600 print artifact.
model StudentActivationCard {
  id                String                     @id @default(uuid())
  batchId           String
  batch             StudentActivationCardBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  studentPersonId   String
  person            Person                     @relation("StudentActivationCardStudent", fields: [studentPersonId], references: [id], onDelete: Restrict)
  codeHmacSha256    String                     @unique
  boundEmailSha256  String
  expiresAt         DateTime
  failedAttempts    Int                        @default(0)
  claimedAt         DateTime?
  usedAt            DateTime?
  revokedAt         DateTime?
  createdAt         DateTime                   @default(now())
  activationRequest StudentActivationRequest?  @relation("StudentActivationRequestCard")

  // The migration owns a partial unique index allowing no more than one
  // unresolved card per student. Prisma cannot express partial indexes.
  @@index([batchId, expiresAt])
  @@index([studentPersonId, expiresAt])
}

/// A document on a student's record. `slot` is a fixed key for the six typed slots
/// (transcript, id-card, enrollment, immunization, aid-letter, passport) or "other"
/// for the free list. `url` is a stored relative upload path served from disk/S3.
model StudentDocument {
  id         String   @id @default(uuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  slot       String
  name       String?
  url        String
  uploadedAt DateTime @default(now())

  @@index([studentId])
}

/// A registrar/faculty broadcast. Fans out into Thread/Message per recipient so
/// replies use the existing messaging rail.
model Broadcast {
  id             String   @id @default(uuid())
  senderId       String
  sender         Person   @relation("BroadcastSender", fields: [senderId], references: [id])
  audienceType   String
  audienceValue  String?
  subject        String
  body           String
  recipientCount Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([senderId])
}

/// Institution-wide payment plan (the DAUST fee sheet): four installments split
/// across Fall/Spring, each with a full-package and a tuition-only amount.
/// Seeds new student invoices; the money itself still rides Invoice/Installment.
model FeePlanInstallment {
  id                 String      @id @default(uuid())
  scheduleId         String
  schedule           FeeSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  academicYearLabel  String
  semester           String
  label              String
  sequence           Int
  /// Inclusive template calendar date in Africa/Dakar (not a timestamp).
  dueOn              DateTime?   @db.Date
  /// Tuition + cafeteria + housing, integer XOF.
  amountFullXof      Int
  /// Tuition only, integer XOF.
  amountTuitionXof   Int
  /// Housing component for this installment, integer XOF.
  amountHousingXof   Int         @default(0)
  /// Cafeteria component for this installment, integer XOF.
  amountCafeteriaXof Int         @default(0)

  @@unique([scheduleId, sequence])
  @@index([academicYearLabel, sequence])
}

/// Immutable revision of the institution-wide annual fee schedule. Exactly one
/// approved revision per academic year is treated as active by application code.
model FeeSchedule {
  id                String                 @id @default(uuid())
  academicYearLabel String
  academicYear      AcademicYear           @relation(fields: [academicYearLabel], references: [label])
  revision          Int
  status            FeeScheduleStatus      @default(draft)
  reason            String?
  createdById       String?
  createdBy         Person?                @relation("FeeScheduleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedById      String?
  approvedBy        Person?                @relation("FeeScheduleApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt        DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  rows              FeePlanInstallment[]
  components        FeeScheduleComponent[]
  invoices          Invoice[]

  @@unique([academicYearLabel, revision])
  @@index([academicYearLabel, status])
}

/// One annual charge in an immutable fee-schedule revision. Components own the
/// money; FeePlanInstallment owns only the dates across which that total is split.
model FeeScheduleComponent {
  id                String             @id @default(uuid())
  scheduleId        String
  schedule          FeeSchedule        @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  key               String
  label             String
  description       String?
  costCenterCode    String
  costCenter        CostCenter         @relation(fields: [costCenterCode], references: [code])
  annualAmountXof   Int
  defaultSelected   Boolean            @default(true)
  sortOrder         Int                @default(0)
  invoiceComponents InvoiceComponent[]
  createdAt         DateTime           @default(now())

  @@unique([scheduleId, key])
  @@index([costCenterCode])
}

/// Generic, version-checked request for a protected finance mutation.
model ApprovalRequest {
  id                   String                 @id @default(uuid())
  kind                 ApprovalRequestKind
  status               ApprovalRequestStatus  @default(pending)
  targetType           String
  targetId             String?
  academicYearLabel    String?
  reason               String
  beforeJson           Json?
  afterJson            Json
  baseRevision         Int
  requestedById        String
  requestedBy          Person                 @relation("ApprovalRequester", fields: [requestedById], references: [id])
  reviewedById         String?
  reviewedBy           Person?                @relation("ApprovalReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt           DateTime?
  appliedAt            DateTime?
  decisionNote         String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  events               ApprovalEvent[]
  operatingBudget      OperatingBudget?       @relation("OperatingBudgetApproval")
  expense              Expense?               @relation("ExpenseApproval")
  expenseVoid          Expense?               @relation("ExpenseVoidApproval")
  managementActual     ManagementActualEntry? @relation("ManagementActualApproval")
  managementActualVoid ManagementActualEntry? @relation("ManagementActualVoidApproval")

  @@index([status, createdAt])
  @@index([requestedById, createdAt])
  @@index([kind, targetId])
}

model ApprovalEvent {
  id        String          @id @default(uuid())
  requestId String
  request   ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  action    String
  actorId   String?
  actor     Person?         @relation("ApprovalEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  data      Json?
  createdAt DateTime        @default(now())

  @@index([requestId, createdAt])
}

/// Validated, curated Director dashboard layout. Widget keys are checked in the API.
model DirectorWidgetPreference {
  id         String   @id @default(uuid())
  personId   String   @unique
  person     Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  widgetKeys String[]
  updatedAt  DateTime @updatedAt
}

/// In-app notification. No email path by design — delivery is the nav badge and the
/// notifications list. `readAt` is per-person, so there is no separate read-state table.
model Notification {
  id               String                  @id @default(uuid())
  personId         String
  person           Person                  @relation(fields: [personId], references: [id], onDelete: Cascade)
  /// Coarse event type: grade_posted | assignment_created | work_graded | material_published |
  /// infirmary_visit_logged | infirmary_emergency_flagged | helpdesk_ticket_created |
  /// helpdesk_ticket_updated | applicant_note_added. New kinds are additive; existing readers
  /// tolerate unknown kinds (the title drives display).
  kind             String
  title            String
  body             String?
  /// Where clicking it should land the reader.
  href             String?
  readAt           DateTime?
  /// Mail delivery outcome. Default `not_attempted` keeps the existing rows consistent;
  /// `deferred` rows are candidates for a future retry cron. `emailStatus` is updated only by
  /// the mail-delivery seam; emitting a notification leaves it `not_attempted` until the
  /// recipient actually gets the email.
  emailStatus      NotificationEmailStatus @default(not_attempted)
  emailAttemptedAt DateTime?
  emailError       String?
  createdAt        DateTime                @default(now())

  @@index([personId, readAt])
  @@index([personId, createdAt])
  @@index([emailStatus])
}

/// Outcome of attempting to deliver a notification by mail. Default `not_attempted` means
/// the in-app row was written but no mail was sent (recipient opted out of mail, or the
/// feature flag is off). `deferred` rows are candidates for a future retry cron.
enum NotificationEmailStatus {
  not_attempted
  sent
  deferred
  failed
}

enum CourseEvaluationKind {
  midterm
  final
}

enum CourseEvaluationStatus {
  draft
  open
  closed
}

/// A round of student course evaluations for one term. The director owns the outer
/// bounds; each instructor may narrow their own section inside them.
model CourseEvaluationWindow {
  id                    String                 @id @default(uuid())
  termId                String
  term                  Term                   @relation(fields: [termId], references: [id], onDelete: Cascade)
  kind                  CourseEvaluationKind
  status                CourseEvaluationStatus @default(draft)
  /// Earliest a section may open, and latest it may close.
  boundsOpenAt          DateTime
  boundsCloseAt         DateTime
  /// Below this many responses a section's results stay hidden. Director-configurable.
  minResponsesToRelease Int                    @default(5)
  createdById           String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  schedules CourseEvaluationSchedule[]
  responses CourseEvaluationResponse[]
  receipts  CourseEvaluationReceipt[]

  @@unique([termId, kind])
}

/// An instructor narrowing their own section's window inside the director's bounds.
/// Optional by design: a section with no row runs the full bounds, so a professor who
/// never touches this is still evaluated. Inaction cannot cancel a round.
model CourseEvaluationSchedule {
  id        String                 @id @default(uuid())
  windowId  String
  window    CourseEvaluationWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)
  sectionId String
  section   Section                @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  opensAt   DateTime
  closesAt  DateTime
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@unique([windowId, sectionId])
}

/// One student's answers. Carries NO link to the student, deliberately and load-bearing:
/// anonymity here is a shape, not a policy, so nothing downstream can undo it by
/// accident. `submittedOn` is a calendar date rather than an instant because two rows
/// written seconds apart in a six-person section would correlate with the receipts.
model CourseEvaluationResponse {
  id          String                 @id @default(uuid())
  windowId    String
  window      CourseEvaluationWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)
  sectionId   String
  section     Section                @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  overall     Int
  clarity     Int
  workload    Int
  comment     String?
  submittedOn DateTime               @db.Date

  @@index([windowId, sectionId])
}

/// Records THAT an enrollment responded, never what they said. Written in the same
/// transaction as the response, sharing no key with it, so the two cannot be joined.
model CourseEvaluationReceipt {
  id           String                 @id @default(uuid())
  windowId     String
  window       CourseEvaluationWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   Enrollment             @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  submittedAt  DateTime               @default(now())

  @@unique([windowId, enrollmentId])
}

// ─── Infirmary ──────────────────────────────────────────────────────────────

model Consultation {
  id               String    @id @default(uuid())
  studentId        String
  student          Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  clinicianId      String?
  clinician        Person?   @relation("ConsultationClinician", fields: [clinicianId], references: [id], onDelete: SetNull)
  reason           String
  visitType        String
  clinicalNotes    String    @default("")
  status           String    @default("Completed")
  vitalsJson       Json?
  diagnosis        String?
  treatmentPlan    String?
  followUpRequired Boolean   @default(false)
  visitedAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  /// Sick flag: when set, today's AttendanceRecord rows for the student are written
  /// as `absent` with `reason = sick | infirmary_emergency`, faculty-of-today and the
  /// admin role receive a notification, and (if `isEmergency`) the
  /// `infirmary.emergencyRecipients` AppSetting list is paged as well.
  sickFlagged      Boolean   @default(false)
  sickFlaggedAt    DateTime?
  sickFlaggedById  String?
  sickFlaggedBy    Person?   @relation("ConsultationSickFlagger", fields: [sickFlaggedById], references: [id], onDelete: SetNull)

  prescriptions Prescription[]

  @@index([studentId])
  @@index([visitedAt])
  @@index([clinicianId])
  @@index([sickFlagged])
}

model Prescription {
  id             String        @id @default(uuid())
  consultationId String?
  consultation   Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  studentId      String
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  authorId       String?
  author         Person?       @relation("PrescriptionAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  medication     String
  dosage         String
  frequency      String
  duration       String
  instructions   String        @default("")
  status         String        @default("Active")
  prescribedAt   DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([studentId])
  @@index([prescribedAt])
  @@index([consultationId])
  @@index([authorId])
}

model Medication {
  id            String   @id @default(uuid())
  name          String
  category      String   @default("General")
  stock         Int      @default(0)
  unit          String   @default("tablets")
  minStock      Int      @default(10)
  expiryDate    DateTime
  supplier      String   @default("")
  lastRestocked DateTime @default(now())
  status        String   @default("In Stock")
  updatedAt     DateTime @updatedAt

  @@index([name])
  @@index([status])
}

model InfirmaryAppointment {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  time      String
  type      String
  reason    String
  status    String   @default("Scheduled")
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([date])
  @@index([status])
}

model InfirmaryDocument {
  id         String   @id @default(uuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  uploaderId String?
  uploader   Person?  @relation("DocumentUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  name       String
  type       String   @default("Other")
  notes      String   @default("")
  url        String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([studentId])
  @@index([uploaderId])
}

model FollowUp {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reason    String
  dueDate   DateTime @db.Date
  status    String   @default("Pending")
  priority  String   @default("Medium")
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([dueDate])
  @@index([status])
}

model InfirmaryForm {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  questions   Json     @default("[]")
  status      String   @default("Draft")
  shareLink   String?
  updatedAt   DateTime @updatedAt

  responses InfirmaryFormResponse[]

  @@index([status])
}

model InfirmaryFormResponse {
  id          String        @id @default(uuid())
  formId      String
  form        InfirmaryForm @relation(fields: [formId], references: [id], onDelete: Restrict)
  studentId   String
  student     Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentName String
  answers     Json          @default("{}")
  submittedAt DateTime      @default(now())

  @@index([formId])
  @@index([studentId])
}

// ─── Custom Forms ─────────────────────────────────────────────────────────────

enum CustomFormStatus {
  draft
  published
  closed
}

enum FormFieldType {
  text
  textarea
  select
  checkbox
  date
}

model CustomForm {
  id            String           @id @default(uuid())
  title         String
  description   String?
  createdById   String
  createdBy     Person           @relation(fields: [createdById], references: [id])
  status        CustomFormStatus @default(draft)
  requiresAuth  Boolean          @default(true)
  publishedAt   DateTime?
  closesAt      DateTime?
  maxResponses  Int?
  responseCount Int              @default(0)
  publicToken   String?          @unique
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  sections  FormSection[]
  responses FormResponse[]

  @@index([status])
  @@index([createdById])
}

model FormSection {
  id            String   @id @default(uuid())
  formId        String
  title         String
  sortOrder     Int      @default(0)
  conditionJson Json?
  createdAt     DateTime @default(now())

  form   CustomForm  @relation(fields: [formId], references: [id])
  fields FormField[]

  @@index([formId, sortOrder])
}

model FormField {
  id            String        @id @default(uuid())
  sectionId     String
  type          FormFieldType
  label         String
  required      Boolean       @default(false)
  sortOrder     Int           @default(0)
  optionsJson   Json?
  conditionJson Json?
  createdAt     DateTime      @default(now())

  section FormSection          @relation(fields: [sectionId], references: [id])
  answers FormResponseAnswer[]

  @@index([sectionId, sortOrder])
}

model FormResponse {
  id              String   @id @default(uuid())
  formId          String
  personId        String?
  respondentName  String?
  respondentEmail String?
  submittedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  form    CustomForm           @relation(fields: [formId], references: [id])
  answers FormResponseAnswer[]

  @@unique([formId, personId])
  @@index([formId])
  @@index([personId])
}

model FormResponseAnswer {
  id         String   @id @default(uuid())
  responseId String
  fieldId    String
  value      Json
  createdAt  DateTime @default(now())

  response FormResponse @relation(fields: [responseId], references: [id])
  field    FormField    @relation(fields: [fieldId], references: [id])

  @@unique([responseId, fieldId])
  @@index([responseId])
  @@index([fieldId])
}
